# Bu faylni `.env` ga nusxalab, o'z qiymatlaringizni yozing.
# `.env` hech qachon git ga tushmaydi (.gitignore).
#
# Har bir mashinada o'z `.env` i bo'ladi. Rolga qarab to'ldiring:
#   SERVER    — bot + hub + o'z agenti (hammasi kerak)
#   KOMPYUTER — faqat agent (4 va 5-bo'limlar yetarli)


# ═══ 1. TELEGRAM — faqat SERVERDA ═══════════════════════════════════
# @BotFather dan olinadi. Bot faqat BITTA joyda ishlashi mumkin —
# ikkinchisi yonsa getUpdates to'qnashadi va xabarlar yo'qoladi.
TELEGRAM_BOT_TOKEN=

# Kim foydalana oladi. Bo'sh bo'lsa — HECH KIM (ataylab shunday).
# ID ni bilish: botga /id yozing yoki `python link.py`.
ALLOWED_USER_IDS=

# Guruh chat ID lari (Forum guruh — parallel sessiyalar uchun).
# Manfiy raqam: -100... Ruxsatli foydalanuvchi guruhda yozsa, ID
# avtomatik qo'shiladi.
ALLOWED_CHAT_IDS=


# ═══ 2. GEMINI — ovoz uchun, faqat SERVERDA ═════════════════════════
# https://aistudio.google.com/apikey (bepul)
GEMINI_API_KEY=
# Taxallus — eskirmaydi. Aniq versiya kerak bo'lsa: gemini-3.8-flash
GEMINI_MODEL=gemini-flash-latest
# Asosiy model 503 "high demand" qaytarsa navbat bilan bularga o'tiladi.
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.1-flash-lite
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore


# ═══ 3. HUB — agentlar shu yerga ulanadi, faqat SERVERDA ════════════
# Hub faqat localhost'da tinglaydi; tashqariga nginx TLS bilan chiqaradi.
HUB_HOST=127.0.0.1
HUB_PORT=8787


# ═══ 4. AGENT — HAR BIR MASHINADA ═══════════════════════════════════
# Server va barcha kompyuterlarda AYNAN BIR XIL bo'lishi shart.
# Yaratish: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_TOKEN=

# Serverning o'zida:  ws://127.0.0.1:8787
# Kompyuterlarda:     wss://<domeningiz>/agent
AGENT_HUB_URL=

# Telegramda /pc ro'yxatida shu nom ko'rinadi: notebook, ishxona, server
AGENT_NAME=


# ═══ 5. CLAUDE — HAR BIR MASHINADA ══════════════════════════════════
# Windows'da odatda `claude`. Linux'da to'liq yo'l kerak bo'lishi mumkin:
# /home/<user>/.local/bin/claude
CLAUDE_BIN=claude

# `claude setup-token` bilan olinadi (bir yil amal qiladi).
CLAUDE_CODE_OAUTH_TOKEN=

DEFAULT_MODEL=opus

# bypassPermissions — hech narsa so'ramaydi (shaxsiy kompyuter)
# acceptEdits      — fayl o'zgartiradi, xavfli komandani so'raydi (server)
# plan             — hech narsa o'zgartirmaydi
PERMISSION_MODE=bypassPermissions

TASK_TIMEOUT_SEC=3600


# ═══ 6. OVOZ ════════════════════════════════════════════════════════
# edge-tts o'zbek ovozlari: uz-UZ-SardorNeural, uz-UZ-MadinaNeural
TTS_VOICE=uz-UZ-SardorNeural
