# Claude Telegram bot — agentlar uchun WebSocket kirish nuqtasi.
# O'RNATISHDAN OLDIN: __DOMAIN__ ni o'z domeningizga almashtiring, yoki:
#     DOMAIN=bot.example.com bash deploy/install.sh

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    # Kompyuterlardagi agentlar shu manzilga ulanadi.
    location /agent {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Agent uzoq vaqt jim turishi mumkin (vazifa kutayotganda) —
        # nginx ulanishni uzib qo'ymasin.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    # Boshqa hamma narsa uchun — hech narsa yo'q.
    location / {
        return 404;
    }
}
